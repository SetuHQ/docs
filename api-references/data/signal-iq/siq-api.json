      "InvalidReportId": {
        "description": "Invalid report id",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "InvalidReportId": {
                "summary": "InvalidReportId",
                "value": {
                  "timestamp": "2025-08-20 11:02:49.657",
                  "version": "0.78.1",
                  "txnid": "",
                  "error": {
                    "code": "api_invalid_ref_id",
                    "type": "validation",
                    "message": "Invalid report id",
